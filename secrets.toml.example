# ============================================================================
# MẪU CẤU HÌNH BÍ MẬT — file này an toàn để commit vì không chứa khóa thật.
#
# KHÔNG BẮT BUỘC. App đã có khóa dự phòng khai báo sẵn trong core/llm_client.py
# nên chạy được ngay sau khi clone.
#
# File này dành cho trường hợp muốn tách khóa khỏi mã nguồn:
#   1. Sao chép thành `.streamlit/secrets.toml` (bỏ đuôi .example)
#   2. Thay YOUR_KEY_HERE bằng khóa thật lấy từ console.groq.com/keys
#   3. .gitignore đã bỏ qua secrets.toml nên khóa sẽ không lên GitHub
#
# Khóa trong file này được ưu tiên hơn khóa dự phòng trong mã nguồn, nên không
# cần sửa code khi chuyển sang cách cấu hình này.
#
# Khi deploy lên Streamlit Cloud: không upload secrets.toml, mà dán nội dung vào
# app → Settings → Secrets.
# ============================================================================

GROQ_API_KEY = "YOUR_KEY_HERE"
